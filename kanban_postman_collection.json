            },
            "url": {
              "raw": "{{baseUrl}}/api/boards/{{boardId}}/columns/{{column1Id}}/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "boards", "{{boardId}}", "columns", "{{column1Id}}", "tickets", "{{ticketId}}"]
