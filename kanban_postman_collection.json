{
  "info": {
    "_postman_id": "kanban-api-collection-v1",
    "name": "Kanban API - Grupo F",
    "description": "Colección completa de pruebas para el backend de gestión de proyectos Kanban con rutas anidadas RESTful",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "boardId",
      "value": "",
      "type": "string"
    },
    {
      "key": "column1Id",
      "value": "",
      "type": "string"
    },
    {
      "key": "column2Id",
      "value": "",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Tableros (Boards)",
      "item": [
        {
          "name": "POST - Crear Tablero",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('boardId', json._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Proyecto Kanban Principal\",\n  \"description\": \"Tablero de seguimiento del sprint\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/boards",
              "host": ["{{baseUrl}}"],
              "path": ["api", "boards"]
            }
          }
        },
        {
          "name": "GET - Listar Tableros",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/boards",
              "host": ["{{baseUrl}}"],
              "path": ["api", "boards"]
            }
          }
        },
        {
          "name": "GET - Obtener Tablero con Columnas y Tickets Poblados",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/boards/{{boardId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "boards", "{{boardId}}"]
            }
          }
        },
        {
          "name": "PATCH - Actualizar Tablero",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Proyecto Kanban - Renombrado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/boards/{{boardId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "boards", "{{boardId}}"]
            }
          }
        },
        {
          "name": "DELETE - Eliminar Tablero (Cascada)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/boards/{{boardId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "boards", "{{boardId}}"]
            }
          }
        }
      ]
    },
